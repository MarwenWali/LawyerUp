# Supabase
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# SSL behavior
DB_SSL=true

# Server Configuration
PORT=3001
# NODE_ENV=development

# JWT Secret
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# AI engine mode:
# - local_python (default): use local ai_iss trained pipeline
# - http: use AI_ENGINE_URL /v1/* endpoints
AI_ENGINE_PROVIDER=local_python
AI_ENGINE_URL=http://127.0.0.1:8001
AI_ENGINE_TIMEOUT_MS=120000
AI_ISS_DISABLE_TORCH=1
# AI_ISS_PYTHON=C:\Users\you\AppData\Local\Programs\Python\Python312\python.exe

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash

EXPO_PUBLIC_API_URL=http://127.0.0.1:3001
